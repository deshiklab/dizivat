{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/lib/auth/session-user": ["src/compat/session-user.shim.ts"],
      "@/*": ["../src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
