# Copy to .env.local and adjust. .env.local is git-ignored.
# Current RBS VAT system — "Open current RBS VAT" button on planned-release pages (hidden when unset)
NEXT_PUBLIC_LEGACY_URL=https://rbs-vat.example.com
# HMAC secret for the session cookie — set a long random value on any shared deployment.
# R5: the web server (middleware) and the NestJS API must use the SAME value.
SESSION_SECRET=change-me

# ── R5 backend (branch r5-nestjs) ────────────────────────────────────────────
# PostgreSQL for the NestJS API (api/). Neon: use the direct connection string with sslmode=require.
DATABASE_URL=postgres://dizivat:dizivat@127.0.0.1:5432/dizivat
# Build AND run the frontend with this set to proxy /api/v1 to the API instead of the in-process mock.
API_UPSTREAM=http://127.0.0.1:4000
# API listen address (default 127.0.0.1:4000)
# API_HOST=127.0.0.1
# API_PORT=4000
